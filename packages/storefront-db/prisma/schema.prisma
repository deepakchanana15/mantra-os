// Shared content schema for Mantra Sports' regional storefronts (CA/DE/NL/IN,
// future UK/NZ) — each site is a standalone Next.js app with its own Postgres
// database, all built from the same template and (as verified field-by-field
// against all four live schema.prisma files) sharing an identical shape for
// every model here, with two documented exceptions:
//
// - `Product.currency`'s @default differs per site (CAD/EUR/INR) — irrelevant
//   here since this client is never used to run migrations against these
//   databases, only to query/mutate existing tables; @default only affects
//   Prisma Migrate's generated SQL, not runtime queries.
// - India's site has five extra Product columns (optionName, optionValues,
//   countryOfOrigin, hsnCode, gstRate — Indian e-commerce/GST compliance
//   fields) and an extra Order/OrderItem domain that CA/DE/NL don't have.
//   Deliberately NOT modeled here: a single generated client can't have
//   per-connection optional columns, and declaring them would break every
//   query against CA/DE/NL (whose tables lack those columns entirely). This
//   means MantraOS's product editor won't expose India's GST/HSN/country-of-
//   origin/option fields yet — flagged back to the user rather than guessed.
//
// `AdminUser` (each site's own admin login) is deliberately NOT modeled here —
// MantraOS's own auth/RBAC replaces it for editing. BlogPost.authorId and
// Media.uploadedBy are kept as plain nullable scalars (no relation) for this
// reason; MantraOS always leaves them null on create.
//
// This client is NEVER pointed at a fixed DATABASE_URL — every call supplies
// the target site's own connection string explicitly (see SiteConnectionManager
// in apps/api/src/modules/storefront/), the same technique already used in
// packages/db/scripts/apply-*-rls.js.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
  DRAFT
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  ON_REQUEST
}

enum EnquiryType {
  QUOTE
  WHOLESALE
  GENERAL
}

enum EnquiryStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SettingType {
  STRING
  JSON
  BOOLEAN
  NUMBER
}

model Product {
  id              String        @id @default(uuid())
  name            String        @db.VarChar(255)
  slug            String        @unique @db.VarChar(255)
  sku             String?       @unique @db.VarChar(100)
  description     String?       @db.Text
  features        String?       @db.Text
  specifications  Json?
  status          ProductStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  isNewArrival    Boolean       @default(false)
  isBestSeller    Boolean       @default(false)
  price           Decimal?      @db.Decimal(10, 2)
  salePrice       Decimal?      @db.Decimal(10, 2)
  currency        String        @db.VarChar(3)
  stockStatus     StockStatus   @default(IN_STOCK)
  stockQty        Int?
  tags            String[]
  metaTitle       String?       @db.VarChar(70)
  metaDescription String?       @db.VarChar(160)
  metaKeywords    String[]
  regions         String[]
  categoryId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  variants           ProductVariant[]
  collectionProducts CollectionProduct[]
  enquiries          Enquiry[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestSeller])
  @@index([createdAt])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String   @db.VarChar(100)
  value     String   @db.VarChar(100)
  sku       String?  @db.VarChar(100)
  price     Decimal? @db.Decimal(10, 2)
  stockQty  Int?
  sortOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String  @db.VarChar(500)
  altText   String? @db.VarChar(255)
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Category {
  id              String  @id @default(uuid())
  name            String  @db.VarChar(100)
  slug            String  @unique @db.VarChar(100)
  description     String? @db.Text
  imageUrl        String? @db.VarChar(500)
  parentId        String?
  metaTitle       String? @db.VarChar(70)
  metaDescription String? @db.VarChar(160)
  sortOrder       Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Collection {
  id              String  @id @default(uuid())
  name            String  @db.VarChar(100)
  slug            String  @unique @db.VarChar(100)
  description     String? @db.Text
  bannerUrl       String? @db.VarChar(500)
  isFeatured      Boolean @default(false)
  metaTitle       String? @db.VarChar(70)
  metaDescription String? @db.VarChar(160)
  sortOrder       Int     @default(0)

  collectionProducts CollectionProduct[]

  @@index([slug])
  @@index([isFeatured])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model Enquiry {
  id          String        @id @default(uuid())
  type        EnquiryType   @default(GENERAL)
  name        String        @db.VarChar(100)
  company     String?       @db.VarChar(100)
  country     String?       @db.VarChar(100)
  email       String        @db.VarChar(255)
  phone       String?       @db.VarChar(50)
  whatsapp    String?       @db.VarChar(50)
  productId   String?
  productName String?       @db.VarChar(255)
  quantity    Int?
  message     String?       @db.Text
  status      EnquiryStatus @default(NEW)
  ipAddress   String?       @db.VarChar(45)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([productId])
  @@index([email])
}

model BlogPost {
  id               String     @id @default(uuid())
  title            String     @db.VarChar(255)
  slug             String     @unique @db.VarChar(255)
  excerpt          String?    @db.Text
  content          String?    @db.Text
  featuredImageUrl String?    @db.VarChar(500)
  authorId         String?
  status           BlogStatus @default(DRAFT)
  publishedAt      DateTime?
  metaTitle        String?    @db.VarChar(70)
  metaDescription  String?    @db.VarChar(160)
  metaKeywords     String[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  categories BlogPostCategory[]
  tags       BlogPostTag[]

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

model BlogCategory {
  id   String @id @default(uuid())
  name String @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  posts BlogPostCategory[]
}

model BlogPostCategory {
  postId     String
  categoryId String

  post     BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model BlogTag {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(100)

  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model SiteSetting {
  key       String      @id @db.VarChar(100)
  value     String?     @db.Text
  type      SettingType @default(STRING)
  updatedAt DateTime    @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  subscribedAt DateTime @default(now())

  @@index([subscribedAt])
}

model Media {
  id         String   @id @default(uuid())
  filename   String   @db.VarChar(255)
  url        String   @db.VarChar(500)
  mimeType   String   @db.VarChar(100)
  size       Int
  altText    String?  @db.VarChar(255)
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([mimeType])
  @@index([createdAt])
}
